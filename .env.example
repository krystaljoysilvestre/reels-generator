# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/reels_dev

# ── Redis (BullMQ) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reels-assets
R2_PUBLIC_URL=                     # optional: public CDN URL for the bucket

# ── LLM: generation + images (OpenAI) ─────────────────────────
# channel creation, stories, scenes, audio script, and still-image generation (gpt-image-1)
OPENAI_API_KEY=

# ── LLM: QA only (Claude API) ─────────────────────────────────
# image vision QA + schema-repair on the QA pass
ANTHROPIC_API_KEY=

# ── Video generation (fal.ai) ─────────────────────────────────
# image→video on hero beats only (OpenAI has no video model)
FAL_KEY=

# ── TTS + SFX (ElevenLabs) ────────────────────────────────────
ELEVENLABS_API_KEY=

# ── YouTube auto-posting (optional) ───────────────────────────
# Leave empty to keep publishing manual (zip download). To enable one-click / automatic uploads:
#  1. Google Cloud Console → create a project → enable "YouTube Data API v3"
#  2. OAuth consent screen → external, add your Google account as a test user
#  3. Credentials → OAuth client ID (Desktop app) → copy client id + secret below
#  4. Mint a refresh token with scope https://www.googleapis.com/auth/youtube.upload
#     while signed in AS THE YOUTUBE CHANNEL you upload to (brand accounts: pick it at sign-in).
#     Easiest: https://developers.google.com/oauthplayground with your own credentials.
# One refresh token = one YouTube channel (Phase 1: the operator's primary channel).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Daily digest email (optional) ─────────────────────────────
# A morning "ready to post" summary via Resend (resend.com — free tier is plenty).
# Leave empty to skip digests entirely.
RESEND_API_KEY=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=          # a verified sender on your Resend domain, e.g. reels@yourdomain.com

# ── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=

# ── Auth (Auth.js / next-auth) ────────────────────────────────
# REQUIRED in every environment — signs the session JWTs (Auth.js errors without it in production).
# Generate one with:  openssl rand -base64 33
AUTH_SECRET=
# The app's canonical origin, used for OAuth callback URLs. Match your deploy origin.
AUTH_URL=http://localhost:3000
# Google sign-in (optional — email + password also works). Create an OAuth client (Web application) and
# add <AUTH_URL>/api/auth/callback/google as an authorized redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Seed / promote the first admin — used by `pnpm --filter @reels/db seed:admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Per-user cost caps (multi-tenant safety; optional overrides) ───
# Defaults live in packages/core (DEFAULT_USER_LIMITS): $50/mo, 20 reels/day. Override globally here;
# per-user overrides live on the users row (monthly_budget_cents / daily_reel_quota).
DEFAULT_USER_MONTHLY_BUDGET_CENTS=5000
DEFAULT_USER_DAILY_REEL_QUOTA=20
# App-wide daily spend kill-switch (cents). Empty = OFF (no global ceiling). When set, the pipeline
# refuses to start a paid step once the whole app's spend today crosses this — a backstop against a
# runaway loop / leaked key summing across all tenants.
GLOBAL_DAILY_SPEND_CAP_CENTS=
# Max reels one (non-admin) user may have building at once — bounds concurrent in-flight spend so a
# burst of creates can't out-run the monthly budget gate. Default 5.
MAX_INFLIGHT_REELS_PER_USER=5

# ── Pipeline liveness (worker) ────────────────────────────────
# Hard ceiling per step so a hung external call frees its worker slot instead of holding it forever.
# The reaper (runs on worker boot) fails reels left 'running' past its threshold; keep it ABOVE the
# render timeout so it never kills a step legitimately running on a sibling worker.
#
# Sized for LONG-FORM. Measured on a 540s reel (42 scenes, 6 animated) on 2026-08-03: render 36m,
# breakdown_scenes 8m. The old example values here (25m render) would have killed that render outright,
# and a step timeout throws away finished work — so leave real headroom, and re-measure if you push
# past ~10 minutes of narration.
PIPELINE_STEP_TIMEOUT_MS=1800000   # 30 min
RENDER_STEP_TIMEOUT_MS=5400000     # 90 min
STUCK_REEL_THRESHOLD_MS=7200000    # 120 min

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
