# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/reels_dev

# ── Redis (BullMQ) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reels-assets
R2_PUBLIC_URL=                     # optional: public CDN URL for the bucket

# ── LLM (Claude API) ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Image + Video generation (fal.ai) ─────────────────────────
FAL_KEY=

# ── TTS + SFX (ElevenLabs) ────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=

# ── Operator auth (single-operator, Phase 1) ──────────────────
OPERATOR_PASSWORD=change-me-before-deploy

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
