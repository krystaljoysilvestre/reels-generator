FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/access-inbox/package.json apps/access-inbox/package.json
COPY apps/contact-inbox/package.json apps/contact-inbox/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/providers/package.json packages/providers/package.json
COPY packages/queue/package.json packages/queue/package.json
COPY packages/render/package.json packages/render/package.json
RUN pnpm install --frozen-lockfile
COPY . .

# Next imports server modules while collecting route metadata. These inert values satisfy module-level
# validation without connecting to infrastructure or baking a production secret into the image.
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build \
    REDIS_URL=redis://127.0.0.1:6379 \
    AUTH_SECRET=build-only-not-a-runtime-secret \
    AUTH_URL=https://app.kendrix.io \
    NEXT_PUBLIC_APP_URL=https://app.kendrix.io \
    pnpm --filter web build

ENV NODE_ENV=production
USER node

CMD ["pnpm", "--filter", "web", "start:railway"]
