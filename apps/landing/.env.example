# Keep this aligned with the studio deployment. The default retains the invitation list.
# Set both apps to open only after the studio's verified signup flow is ready.
SIGNUP_MODE=approval

# Canonical app origin for sign-in, signup and guide links.
KENDRIX_APP_URL=https://app.kendrix.io

# Waitlist capture for the "Get access" form.
# Points at apps/access-inbox (Cloudflare Worker: D1 list + inbox notification) — see its README
# for the one-time deploy. The payload is Buttondown-shaped, so a hosted list can be swapped in
# here with no code change on either side.
# Leave unset to keep the form in "requests aren't open yet" mode.
KENDRIX_LIST_ENDPOINT=
KENDRIX_LIST_API_KEY=

# Inbox webhook for the contact-page form — apps/contact-inbox (deployed 2026-08-05).
# Leave unset to have the form direct people to hello@kendrix.io instead.
KENDRIX_CONTACT_ENDPOINT=
KENDRIX_CONTACT_API_KEY=
