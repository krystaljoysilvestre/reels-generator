# Hosted-list capture for the "Get access" form (e.g. Buttondown).
# Leave unset to keep the form in "requests aren't open yet" mode.
KENDRIX_LIST_ENDPOINT=
KENDRIX_LIST_API_KEY=

# Inbox webhook for the contact-page form (e.g. a form-inbox or email webhook).
# Leave unset to have the form direct people to hello@kendrix.io instead.
KENDRIX_CONTACT_ENDPOINT=
KENDRIX_CONTACT_API_KEY=
